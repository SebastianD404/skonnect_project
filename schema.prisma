generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pgcrypto, uuid_ossp(map: "uuid-ossp"), pg_stat_statements, supabase_vault]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  YOUTH         // public resident, no SKEAP record yet
  GRANTEE       // approved SKEAP scholar
  SK_OFFICIAL   // SK Chairperson / Councilors - admin dashboard access
  SUPER_ADMIN   // system administration / governance
}

enum GranteeStatus {
  ACTIVE
  PROBATIONARY
  GRADUATED
  REMOVED
}

enum EventStatus {
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED_FOR_EDIT
}

enum Language {
  ENGLISH
  FILIPINO
  ILOCANO
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

// ─────────────────────────────────────────────
// CORE USER & AUTH
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  // Mirrors the Supabase Auth user id (auth.users.id) - keep in sync, do not
  // generate a separate auth system. This table holds app-level profile data.
  authId        String   @unique
  email         String   @unique
  username      String?  @unique
  fullName      String
  phoneNumber   String?
  avatarUrl     String?  // Supabase Storage path for user avatar
  role          Role     @default(YOUTH)
  languagePref  Language @default(ENGLISH)
  settings      Json?
  mustSecureAccount    Boolean  @default(false)
  usesTemporaryPassword Boolean @default(false)
  kkProfileId          String?  @unique
  kkProfile            KKProfile? @relation(fields: [kkProfileId], references: [id], onDelete: SetNull)

  barangay      String   @default("Pico")
  isActive      Boolean  @default(true)
  hasSeenOnboarding Boolean @default(false)

  grantee                 Grantee?
  registrations           Registration[]
  profilingRegistrations ProfilingRegistration[]
  inquiries               Inquiry[]
  announcements           Announcement[]
  auditLogs               AuditLog[]       @relation("ActorAuditLogs")
  eventsCreated           Event[]          @relation("EventCreator")
  chatMessages            ChatMessage[]
  skeapApplications       SkeapApplication[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

model KKProfile {
  id            String   @id @default(uuid())
  firstName     String
  middleName    String?
  lastName      String
  fullName      String
  purok         String
  addressLine   String
  barangay      String   @default("Pico")
  birthDate     DateTime
  contactNumber String
  email         String   @unique
  isVerified    Boolean  @default(true)

  user          User?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lastName, firstName])
  @@map("kk_profiles")
}

model SkeapApplication {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCourse     String
  yearLevel         String
  gwa               Decimal?         @db.Decimal(4, 2)
  enrollmentFileUrl String
  reportCardFileUrl String
  status            SubmissionStatus @default(PENDING)
  submittedAt       DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId, submittedAt(sort: Desc)])
  @@map("skeap_applications")
}

// ─────────────────────────────────────────────
// SKEAP SCHOLARSHIP MANAGEMENT
// ─────────────────────────────────────────────

model Grantee {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          GranteeStatus @default(ACTIVE)
  yearLevel       String
  school          String
  generalAverage  Float?

  submissions     Submission[]

  dateEnrolled    DateTime @default(now())
  dateRemoved     DateTime?
  remarks         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("grantees")
}

model Submission {
  id              String           @id @default(uuid())
  granteeId       String
  grantee         Grantee          @relation(fields: [granteeId], references: [id], onDelete: Cascade)

  semester        String           // e.g. "2026-1st Semester"
  gradeFileUrl    String           // Supabase Storage path
  coeFileUrl      String           // Certificate of Enrollment - Supabase Storage path
  generalAverage  Float?

  status          SubmissionStatus @default(PENDING)
  reviewedById    String?
  reviewNotes     String?
  flaggedFields   String[]         @default([])

  submittedAt     DateTime @default(now())
  reviewedAt       DateTime?

  @@map("submissions")
}

// ─────────────────────────────────────────────
// EVENT MANAGEMENT
// ─────────────────────────────────────────────

model Event {
  id              String      @id @default(uuid())
  title           String
  description     String
  venue           String
  eventDate       DateTime

  maxSlots        Int
  filledSlots     Int         @default(0)
  imageUrl        String?
  status          EventStatus @default(UPCOMING)

  isKatipunan     Boolean     @default(false) // Katipunan ng Kabataan special event type
  payoutSchedule  String?

  createdById     String
  createdBy       User        @relation("EventCreator", fields: [createdById], references: [id])

  registrations   Registration[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("events")
}

model Registration {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  registeredAt DateTime @default(now())

  @@unique([eventId, userId]) // prevents double-registration
  @@map("registrations")
}

model ProfilingRegistration {
  id                    String   @id @default(uuid())
  program               String   @default("KK")
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName              String
  address               String
  sex                   String
  age                   Int
  birthDate             DateTime
  email                 String
  facebook              String
  contactNumber         String
  civilStatus           String
  youthClassification   String
  youthAgeGroup         String
  workStatus            String
  educationalBackground String
  registeredSKVoter     String
  votedLastSK           String
  registeredNationalVoter String
  attendedKKAssembly    String
  assemblyTimes         String?
  noAssemblyReason      String?
  consent               Boolean  @default(true)
  submittedAt           DateTime @default(now())

  @@map("kk_profiling_registrations")
}

// ─────────────────────────────────────────────
// INQUIRIES (public Inquiry Form -> SK admin dashboard)
// ─────────────────────────────────────────────

model Inquiry {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject     String
  message     String
  language    Language @default(ENGLISH)

  isResolved    Boolean  @default(false)
  response      String?
  respondedAt   DateTime?
  reviewThread  Json?
  reviewStatus  String   @default("Pending review")
  lastUpdatedBy String?
  resubmittedAt DateTime?

  createdAt   DateTime @default(now())

  @@map("inquiries")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS (log of automated emails sent)
// ─────────────────────────────────────────────

model NotificationLog {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "deadline_reminder" | "status_change" | "event_announcement" | "registration_confirmation"
  channel     String   @default("email")
  subject     String
  sentAt      DateTime @default(now())
  success     Boolean  @default(true)

  @@map("notification_logs")
}

// ─────────────────────────────────────────────
// AUDIT LOGGING (System Administration module)
// ─────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actor       User     @relation("ActorAuditLogs", fields: [actorId], references: [id])

  action      String   // e.g. "UPDATE_GRANTEE_STATUS", "DELETE_EVENT"
  targetTable String   // e.g. "grantees"
  targetId    String   // id of the affected row
  beforeData  Json?
  afterData   Json?
  metadata    Json?

  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// ANNOUNCEMENTS (SK Officials Announcements)
// ─────────────────────────────────────────────

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String   // Full announcement content
  imageUrl    String?  // Supabase Storage path for announcement image
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("announcements")
}

// ─────────────────────────────────────────────
// AI CHATBOT - RAG KNOWLEDGE BASE (pgvector)
// ─────────────────────────────────────────────

model ChatEmbedding {
  id          String                 @id @default(uuid())
  content     String                 // the source FAQ/info chunk, in its original language
  language    Language
  sourceType  String                 // "skeap_faq" | "event_info" | "general"
  // pgvector column - Gemini text-embedding-004 outputs 768 dimensions
  embedding   Unsupported("vector(768)")?

  createdAt   DateTime @default(now())

  @@map("chat_embeddings")
}

model ChatLog {
  id          String   @id @default(uuid())
  userId      String?  // nullable - allow anonymous youth visitors to use the chatbot
  question    String
  detectedLanguage Language
  answer      String
  wasEscalated Boolean @default(false) // true if bot couldn't answer and routed to Inquiry Form

  createdAt   DateTime @default(now())

  @@map("chat_logs")
}

model ChatMessage {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ChatMessageRole
  content     String
  language    Language
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("chat_messages")
}
