generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_stat_statements, pgcrypto, supabase_vault, uuid_ossp(map: "uuid-ossp"), vector]
}

enum Sex {
  MALE
  FEMALE
  NOT_SPECIFIED
}

model User {
  id                     String                  @id @default(uuid())
  authId                 String                  @unique
  email                  String                  @unique
  fullName               String
  phoneNumber            String?
  role                   Role                    @default(YOUTH)
  kkStatus               String                  @default("UNPROFILED") @map("kk_status")
  languagePref           Language                @default(ENGLISH)
  barangay               String                  @default("Pico")
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  settings               Json?
  avatarUrl              String?
  hasSeenOnboarding      Boolean                 @default(false)
  username               String?                 @unique
  mustSecureAccount      Boolean                 @default(false)
  usesTemporaryPassword  Boolean                 @default(false)
  kkProfileId            String?                 @unique
  emailNotifications     Boolean                 @default(true)
  announcements          Announcement[]
  auditLogs              AuditLog[]              @relation("ActorAuditLogs")
  createdBackups         BackupLog[]             @relation("BackupLogCreator")
  chatMessages           ChatMessage[]
  sentGranteeMessages    GranteeMessage[]        @relation("GranteeMessageSender")
  granteeMessages        GranteeMessage[]        @relation("GranteeMessageRecipient")
  grantee                Grantee?
  inquiries              Inquiry[]
  profilingRegistrations ProfilingRegistration[]
  notifications          Notification[]
  registrations          registrations[]
  reminderLogs           ReminderLog[]
  skeapApplications      SkeapApplication[]
  kkProfile              KKProfile?              @relation(fields: [kkProfileId], references: [id])

  @@map("users")
}

model KKProfile {
  id            String   @id @default(uuid())
  firstName     String
  middleName    String?
  lastName      String
  fullName      String
  purok         String
  addressLine   String
  barangay      String   @default("Pico")
  birthDate     DateTime
  placeOfBirth  String?
  contactNumber String
  sex           Sex      @default(NOT_SPECIFIED)
  email         String   @unique
  isVerified    Boolean  @default(true)
  idDocumentHash String? @map("id_document_hash")
  duplicateFlag String?  @map("duplicate_flag")
  duplicateNote String?  @map("duplicate_note")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?

  @@index([lastName, firstName])
  @@index([idDocumentHash])
  @@map("kk_profiles")
}

model Grantee {
  id                 String            @id @default(uuid())
  userId             String            @unique
  status             GranteeStatus     @default(ACTIVE)
  revocationReason   String?
  revocationNotes    String?
  revocationProofPath     String? @map("revocation_proof_path")
  revocationProofFileName String? @map("revocation_proof_file_name")
  revocationProofType     String? @map("revocation_proof_type")
  revocationProofHash     String? @map("revocation_proof_hash")
  revocationProofMimeType String? @map("revocation_proof_mime_type")
  isPermanentlyDisqualified Boolean   @default(false)
  identityFingerprint String?
  revocationNotificationStatus   GranteeRevocationNotificationStatus @default(NOT_REQUIRED)
  revocationNotificationAttempts Int @default(0)
  revocationNotificationError    String?
  revocationNotificationSentAt    DateTime?
  yearLevel          String
  entryAcademicYear  String?
  entrySemester      String?
  journeyStart       String?
  journeyEnd         String?
  school             String
  generalAverage     Float?
  dateEnrolled       DateTime          @default(now())
  dateRemoved        DateTime?
  remarks            String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  graduatedAt        DateTime?
  graduatedBy        String?
  graduationReadyAt  DateTime?
  exitClearanceStatus ExitClearanceStatus @default(NONE)
  exitClearanceUrl   String?
  exitClearanceFileName String?
  exitClearanceSubmittedAt DateTime?
  schoolClearanceVerified Boolean       @default(false)
  skClearanceVerified Boolean           @default(false)
  graduationRemarks  String?
  retentionExpiresAt DateTime?
  payout             AccountingPayout?
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions        Submission[]

  @@index([status, updatedAt(sort: Desc)])
  @@map("grantees")
}

view inactive_grantees_view {
  id             String        @unique
  userId         String
  status         GranteeStatus
  yearLevel      String
  school         String
  generalAverage Float?
  dateEnrolled   DateTime
  dateRemoved    DateTime?
  remarks        String?
  createdAt      DateTime
  updatedAt      DateTime
  graduatedAt    DateTime?

  @@map("inactive_grantees_view")
}

model Submission {
  id                         String              @id @default(uuid())
  granteeId                  String
  semester                   String
  gradeFileUrl               String
  coeFileUrl                 String
  generalAverage             Float?
  status                     SubmissionStatus    @default(PENDING)
  reviewedById               String?
  reviewNotes                String?
  submittedAt                DateTime            @default(now())
  reviewedAt                 DateTime?
  physicalVerifiedBy         String?
  physicalVerifiedAt         DateTime?
  flaggedFields              String[]            @default([])
  coeStatus                  SubmissionStatus    @default(PENDING)
  gradesStatus               SubmissionStatus    @default(PENDING)
  coeSubmittedAt             DateTime            @default(now())
  coeApprovedAt              DateTime?
  gradesSubmittedAt          DateTime?
  gradesApprovedAt           DateTime?
  gradeRows                  Json?
  gradeReportSemester        String?
  ocrConfidence              Float?
  ocrGwa                     Float?
  ocrParsedRows              Json?
  ocrRawText                 String?
  ocrStatus                  SubmissionOcrStatus @default(OCR_PENDING)
  ocrTotalUnits              Float?
  requiresStrictManualReview Boolean             @default(false)
  resubmittedFields          String[]            @default([])
  grantee                    Grantee             @relation(fields: [granteeId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt(sort: Desc)])
  @@index([granteeId, submittedAt(sort: Desc)])
  @@index([coeStatus, submittedAt(sort: Desc)])
  @@index([gradesStatus, gradesSubmittedAt(sort: Desc)])
  @@map("submissions")
}

model SkeapApplication {
  id                       String           @id @default(uuid())
  userId                   String
  currentCourse            String
  yearLevel                String
  gwa                      Float?
  enrollmentFileUrl        String
  reportCardFileUrl        String
  status                   SubmissionStatus @default(PENDING)
  physicalDocumentsConfirmed Boolean         @default(false)
  submittedAt              DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  withdrawnAt              DateTime?
  withdrawalReason         String?
  applicantName            String?
  permanentAddress         String?
  dateOfBirth              DateTime?
  placeOfBirth             String?
  fathersName              String?
  fathersOccupation        String?
  fathersContact           String?
  mothersMaidenName        String?
  mothersOccupation        String?
  contactNumber            String?
  emailAddress             String?
  uploadedFiles            Json?
  photoFileUrl             String?
  age                      Int?
  civilStatus              String?
  mothersContact           String?
  school                   String
  gender                   String?
  grades                   Json?
  timeline                 Json?
  parentGuardianRegisteredVoter Boolean?
  parentGuardianVoterFullName String?
  parentGuardianName      String?
  parentGuardianContact    String?
  numberOfDependents      Int?
  waitlistPosition         Int?
  waitlistFinalPosition    Int?
  waitlistRemark           String?          @map("waitlist_remark")
  educationalBackground    Json?
  registeredVoter          Boolean?
  totalFamilyMonthlyIncome String?
  educationLevel           String?
  inquiry                  Inquiry?
  waitlistOfferStatus      WaitlistOfferStatus @default(NONE)
  waitlistOfferedAt        DateTime?
  waitlistOfferExpiresAt   DateTime?
  waitlistOfferReminderSentAt DateTime?
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt(sort: Desc)])
  @@index([status, waitlistPosition])
  @@index([status, waitlistOfferStatus, waitlistOfferExpiresAt])
  @@map("skeap_applications")
}

view skeap_applications_admin_mv {
  id                    String   @unique
  inquiryId             String?
  inquiryCreatedAt      DateTime?
  userId                String
  fullName              String
  email                 String
  age                   Int?
  phone                 String?
  sitio                 String?
  school                String?
  educationLevel        String?
  course                String?
  yearLevel             String?
  status                String
  reviewStatus          String?
  withdrawnAt           DateTime?
  withdrawalReason      String?
  submittedAt           DateTime
  updatedAt             DateTime
  documentCount         Int
  ocrNameMismatchCount  Int
  hasOcrNameMismatch    Boolean

  @@map("skeap_applications_admin_mv")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model ProfilingRegistration {
  id                                String   @id @default(uuid())
  program                           String   @default("KK")
  userId                            String?
  fullName                          String
  address                           String
  sex                               String
  age                               Int
  birthDate                         DateTime
  email                             String
  facebook                          String
  contactNumber                     String
  civilStatus                       String
  youthClassification               String
  youthAgeGroup                     String
  workStatus                        String
  educationalBackground             String
  registeredSKVoter                 String
  votedLastSK                       String
  registeredNationalVoter           String
  attendedKKAssembly                String
  assemblyTimes                     String?
  noAssemblyReason                  String?
  consent                           Boolean  @default(true)
  submittedAt                       DateTime @default(now())
  reviewStatus                      String   @default("Pending")
  withdrawnAt                       DateTime?
  withdrawalReason                  String?
  archivedReason                    String?  @map("archived_reason")
  archivedAt                        DateTime? @map("archived_at")
  archivedBy                        String?  @map("archived_by")
  reviewNotes                       String?
  idBackFileUrl                     String?
  birthCertificateFileUrl           String?
  idDocumentType                    String?
  idFrontFileUrl                    String?
  photoFileUrl                      String?
  idSingleFileUrl                   String?
  residencyStatementAcknowledgement Boolean  @default(false)
  middleName                        String   @default("")
  requiresManualReview              Boolean  @default(false) @map("requires_manual_review")
  user                              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewStatus, submittedAt(sort: Desc)])
  @@index([reviewStatus, birthDate])
  @@map("kk_profiling_registrations")
}

view kk_profiling_applications_admin_mv {
  id                       String   @unique
  program                  String
  userId                   String?
  fullName                 String
  email                    String
  address                  String
  sex                      String
  age                      Int
  ageGroup                 String?
  birthDate                DateTime
  facebook                 String
  contactNumber            String
  civilStatus              String
  youthClassification      String
  classification           String
  youthAgeGroup            String
  workStatus               String
  educationalBackground    String
  registeredSKVoter        String
  isSkVoter                Boolean
  votedLastSK              String
  registeredNationalVoter  String
  attendedKKAssembly       String
  assemblyTimes            String?
  noAssemblyReason         String?
  consent                  Boolean
  submittedAt              DateTime
  reviewStatus             String
  status                   String
  withdrawnAt              DateTime?
  withdrawalReason         String?
  archivedReason           String?
  archivedAt               DateTime?
  reviewNotes              String?
  idBackFileUrl            String?
  birthCertificateFileUrl  String?
  idDocumentType           String?
  idFrontFileUrl           String?
  photoFileUrl             String?
  idSingleFileUrl          String?
  residencyStatementAcknowledgement Boolean
  middleName               String
  requiresManualReview     Boolean
  skeapStatus              String?
  granteeId                String?

  @@map("kk_profiling_applications_admin_mv")
}

view system_users_admin_mv {
  userId                    String           @unique @map("user_id")
  fullName                  String           @map("full_name")
  displayName               String           @map("display_name")
  email                     String
  role                      Role
  isActive                  Boolean          @map("is_active")
  createdAt                 DateTime         @map("created_at")
  updatedAt                 DateTime         @map("updated_at")
  avatarUrl                 String?          @map("avatar_url")
  username                  String?
  phoneNumber               String?          @map("phone_number")
  barangay                  String
  languagePref              Language         @map("language_pref")
  granteeStatus             GranteeStatus?   @map("grantee_status")
  granteeSchool             String?          @map("grantee_school")
  granteeYearLevel          String?          @map("grantee_year_level")
  granteeGeneralAverage     Float?           @map("grantee_general_average")
  granteeDateEnrolled       DateTime?        @map("grantee_date_enrolled")
  granteeArchivedAt         DateTime?        @map("grantee_archived_at")
  granteeRetentionExpiresAt DateTime?        @map("grantee_retention_expires_at")
  skeapApplicationStatus    SubmissionStatus? @map("skeap_application_status")
  skeapStatus               String           @map("skeap_status")
  segment                   String

  @@map("system_users_admin_mv")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  authorId    String
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
  author      User     @relation(fields: [authorId], references: [id])

  @@map("announcements")
}

model Inquiry {
  id            String            @id @default(uuid())
  userId        String
  subject       String
  message       String
  language      Language          @default(ENGLISH)
  isResolved    Boolean           @default(false)
  response      String?
  respondedAt   DateTime?
  createdAt     DateTime          @default(now())
  reviewThread  Json?
  lastUpdatedBy String?
  resubmittedAt DateTime?
  reviewStatus  String            @default("Pending review")
  applicationId String?           @unique
  application   SkeapApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isResolved, createdAt(sort: Desc)])
  @@map("inquiries")
}

model NotificationLog {
  id      String   @id @default(uuid())
  userId  String
  type    String
  channel String   @default("email")
  subject String
  sentAt  DateTime @default(now())
  success Boolean  @default(true)

  @@map("notification_logs")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  sourceKey String
  message   String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, sourceKey])
  @@index([userId, isRead])
  @@map("notifications")
}

model AdminNotification {
  id        String   @id @default(uuid())
  sourceKey String?  @unique
  title     String
  message   String
  type      String
  href      String?
  createdAt DateTime @default(now())

  @@map("admin_notifications")
}

model GranteeMessage {
  id        String   @id @default(uuid())
  userId    String
  senderId  String?
  subject   String
  body      String
  createdAt DateTime @default(now())
  sender    User?    @relation("GranteeMessageSender", fields: [senderId], references: [id], onUpdate: NoAction)
  user      User     @relation("GranteeMessageRecipient", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)])
  @@map("grantee_messages")
}

model ReminderSetting {
  id        String       @id @default(uuid())
  type      ReminderType @unique
  offsets   Int[]        @default([])
  deadline  DateTime?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("reminder_settings")
}

model AcademicTermSchedule {
  id        String   @id @default(uuid())
  semester  String   @unique
  opensAt   DateTime
  closesAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opensAt, closesAt])
  @@map("academic_term_schedules")
}

model ReminderLog {
  id           String       @id @default(uuid())
  userId       String
  reminderType ReminderType
  targetType   String
  targetId     String?
  triggerDate  DateTime
  channel      String
  sentAt       DateTime     @default(now())
  success      Boolean      @default(true)
  metadata     Json?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder_logs")
}

model MessageTemplate {
  id        String                 @id @default(uuid())
  type      MessageTemplateType
  channel   MessageTemplateChannel
  subject   String                 @default("")
  body      String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([type, channel])
  @@map("message_templates")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  action      String
  targetTable String
  targetId    String
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime @default(now())
  metadata    Json?
  recorded    DateTime @default(now())
  meta        Json?
  actor       User     @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model BackupLog {
  id              String        @id @default(uuid())
  fileName        String
  trigger         BackupTrigger
  status          BackupStatus
  recordCounts    Json
  fileSizeBytes   Int
  checksumSha256  String
  storagePath     String?
  createdByLabel  String?
  errorMessage    String?
  createdById     String?
  createdAt       DateTime      @default(now())
  createdBy       User?         @relation("BackupLogCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("backup_logs")
}

model ChatEmbedding {
  id         String                 @id @default(uuid())
  content    String
  language   Language
  sourceType String
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())

  @@map("chat_embeddings")
}

model ChatLog {
  id               String   @id @default(uuid())
  userId           String?
  question         String
  detectedLanguage Language
  answer           String
  wasEscalated     Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@map("chat_logs")
}

model ChatMessage {
  id        String          @id @default(uuid())
  userId    String
  role      ChatMessageRole
  content   String
  language  Language
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("chat_messages")
}

model AdminSettings {
  key         String @id
  totalBudget Int    @default(0)

  @@map("admin_settings")
}

model Semester {
  id        String  @id @default(uuid())
  name      String
  isCurrent Boolean @default(false)

  @@map("semesters")
}

model AccountingPayout {
  id                      String                 @id @default(uuid())
  granteeId               String                 @unique
  amount                  Int
  semester                String?
  status                  AccountingPayoutStatus @default(PENDING)
  disbursedAt             DateTime?              @map("disbursed_at")
  claimedAt               DateTime?              @map("claimed_at")
  disbursementEmailSentAt DateTime?              @map("disbursement_email_sent_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  grantee                 Grantee                @relation(fields: [granteeId], references: [id])

  @@map("accounting_payouts")
}

enum AccountingPayoutStatus {
  NOT_YET_FILED
  PENDING
  DISBURSED_UNCONFIRMED
  CONFIRMED
}

model registrations {
  id            String   @id
  eventId       String
  userId        String
  registeredAt  DateTime @default(now())
  address       String?
  age           Int?
  contactNumber String?
  email         String?
  fullName      String?
  sex           String?
  users         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

enum SubmissionOcrStatus {
  OCR_PENDING
  OCR_DONE
  OCR_NEEDS_REVIEW
  OCR_FAILED
}

enum ReminderType {
  SKEAP_APPLICATION
  EVENT_REGISTRATION
}

enum MessageTemplateType {
  DEADLINE_REMINDER
  PAYOUT_ASSEMBLY
}

enum MessageTemplateChannel {
  EMAIL
  SMS
}

enum Role {
  YOUTH
  GRANTEE
  SK_OFFICIAL
  SUPER_ADMIN
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
  AUTOMATED
}

enum BackupStatus {
  COMPLETED
  FAILED
}

enum GranteeStatus {
  ACTIVE
  PROBATIONARY
  GRADUATED
  REMOVED
  REVOKED
}

enum ExitClearanceStatus {
  NONE
  SUBMITTED
  RETURNED
  CLEARED
}

enum GranteeRevocationNotificationStatus {
  NOT_REQUIRED
  PENDING
  SENDING
  FAILED
  SENT
}

enum EventStatus {
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  COMPLETED
}

enum SubmissionStatus {
  DRAFT
  PENDING
  AWAITING_PHYSICAL_CTC
  PRE_QUALIFIED
  APPROVED
  REJECTED
  RETURNED_FOR_EDIT
  WAITLISTED
  REMOVED
  WITHDRAWN
}

enum WaitlistOfferStatus {
  NONE
  OFFERED
  EXPIRED
}

enum Language {
  ENGLISH
  FILIPINO
  ILOCANO
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum EventAllowedType {
  SOLO_ONLY
  GROUP_ONLY
  BOTH
}
