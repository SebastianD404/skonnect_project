generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_stat_statements, pgcrypto, supabase_vault, uuid_ossp(map: "uuid-ossp"), vector]
}

model User {
  id                     String                  @id @default(uuid())
  authId                 String                  @unique
  email                  String                  @unique
  fullName               String
  phoneNumber            String?
  role                   Role                    @default(YOUTH)
  languagePref           Language                @default(ENGLISH)
  barangay               String                  @default("Pico")
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  settings               Json?
  avatarUrl              String?
  hasSeenOnboarding      Boolean                 @default(false)
  username               String?                 @unique
  mustSecureAccount      Boolean                 @default(false)
  usesTemporaryPassword  Boolean                 @default(false)
  kkProfileId            String?                 @unique
  emailNotifications     Boolean                 @default(true)
  announcements          Announcement[]
  auditLogs              AuditLog[]              @relation("ActorAuditLogs")
  chatMessages           ChatMessage[]
  sentGranteeMessages    GranteeMessage[]        @relation("GranteeMessageSender")
  granteeMessages        GranteeMessage[]        @relation("GranteeMessageRecipient")
  grantee                Grantee?
  inquiries              Inquiry[]
  profilingRegistrations ProfilingRegistration[]
  notifications          Notification[]
  registrations          registrations[]
  reminderLogs           ReminderLog[]
  skeapApplications      SkeapApplication[]
  kkProfile              KKProfile?              @relation(fields: [kkProfileId], references: [id])

  @@map("users")
}

model KKProfile {
  id            String   @id @default(uuid())
  firstName     String
  middleName    String?
  lastName      String
  fullName      String
  purok         String
  addressLine   String
  barangay      String   @default("Pico")
  birthDate     DateTime
  contactNumber String
  email         String   @unique
  isVerified    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?

  @@index([lastName, firstName])
  @@map("kk_profiles")
}

model Grantee {
  id             String        @id @default(uuid())
  userId         String        @unique
  status         GranteeStatus @default(ACTIVE)
  yearLevel      String
  school         String
  generalAverage Float?
  dateEnrolled   DateTime      @default(now())
  dateRemoved    DateTime?
  remarks        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions    Submission[]

  @@map("grantees")
}

model Submission {
  id                String           @id @default(uuid())
  granteeId         String
  semester          String
  gradeFileUrl      String
  coeFileUrl        String
  generalAverage    Float?
  status            SubmissionStatus @default(PENDING)
  reviewedById      String?
  reviewNotes       String?
  submittedAt       DateTime         @default(now())
  reviewedAt        DateTime?
  flaggedFields     String[]         @default([])
  coeStatus         SubmissionStatus @default(PENDING)
  gradesStatus      SubmissionStatus @default(PENDING)
  coeSubmittedAt    DateTime         @default(now())
  coeApprovedAt     DateTime?
  gradesSubmittedAt DateTime?
  gradesApprovedAt  DateTime?
  gradeRows         Json?
  grantee           Grantee          @relation(fields: [granteeId], references: [id], onDelete: Cascade)

  @@index([coeStatus, submittedAt(sort: Desc)])
  @@index([gradesStatus, gradesSubmittedAt(sort: Desc)])
  @@map("submissions")
}

model SkeapApplication {
  id                String           @id @default(uuid())
  userId            String
  currentCourse     String
  yearLevel         String
  gwa               Float?
  enrollmentFileUrl String
  reportCardFileUrl String
  status            SubmissionStatus @default(PENDING)
  submittedAt       DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  applicantName     String?
  permanentAddress  String?
  dateOfBirth       DateTime?
  placeOfBirth      String?
  fathersName       String?
  fathersOccupation String?
  fathersContact    String?
  mothersMaidenName String?
  mothersOccupation String?
  contactNumber     String?
  emailAddress      String?
  uploadedFiles     Json?
  photoFileUrl      String?
  age               Int?
  civilStatus       String?
  mothersContact    String?
  school            String
  gender            String?
  grades            Json?
  timeline          Json?
  waitlistPosition  Int?
  inquiry           Inquiry?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt(sort: Desc)])
  @@index([status, waitlistPosition])
  @@map("skeap_applications")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model ProfilingRegistration {
  id                                String   @id @default(uuid())
  program                           String   @default("KK")
  userId                            String?
  fullName                          String
  address                           String
  sex                               String
  age                               Int
  birthDate                         DateTime
  email                             String
  facebook                          String
  contactNumber                     String
  civilStatus                       String
  youthClassification               String
  youthAgeGroup                     String
  workStatus                        String
  educationalBackground             String
  registeredSKVoter                 String
  votedLastSK                       String
  registeredNationalVoter           String
  attendedKKAssembly                String
  assemblyTimes                     String?
  noAssemblyReason                  String?
  consent                           Boolean  @default(true)
  submittedAt                       DateTime @default(now())
  reviewStatus                      String   @default("Pending")
  reviewNotes                       String?
  idBackFileUrl                     String?
  idDocumentType                    String?
  idFrontFileUrl                    String?
  idSingleFileUrl                   String?
  residencyStatementAcknowledgement Boolean  @default(false)
  middleName                        String   @default("")
  user                              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kk_profiling_registrations")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  authorId    String
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
  author      User     @relation(fields: [authorId], references: [id])

  @@map("announcements")
}

model Inquiry {
  id            String            @id @default(uuid())
  userId        String
  subject       String
  message       String
  language      Language          @default(ENGLISH)
  isResolved    Boolean           @default(false)
  response      String?
  respondedAt   DateTime?
  createdAt     DateTime          @default(now())
  reviewThread  Json?
  lastUpdatedBy String?
  resubmittedAt DateTime?
  reviewStatus  String            @default("Pending review")
  applicationId String?           @unique
  application   SkeapApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("inquiries")
}

model NotificationLog {
  id      String   @id @default(uuid())
  userId  String
  type    String
  channel String   @default("email")
  subject String
  sentAt  DateTime @default(now())
  success Boolean  @default(true)

  @@map("notification_logs")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  sourceKey String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, sourceKey])
  @@index([userId, isRead])
  @@map("notifications")
}

model GranteeMessage {
  id        String   @id @default(uuid())
  userId    String
  senderId  String?
  subject   String
  body      String
  createdAt DateTime @default(now())
  sender    User?    @relation("GranteeMessageSender", fields: [senderId], references: [id], onUpdate: NoAction)
  user      User     @relation("GranteeMessageRecipient", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)])
  @@map("grantee_messages")
}

model ReminderSetting {
  id        String       @id @default(uuid())
  type      ReminderType @unique
  offsets   Int[]        @default([])
  deadline  DateTime?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("reminder_settings")
}

model ReminderLog {
  id           String       @id @default(uuid())
  userId       String
  reminderType ReminderType
  targetType   String
  targetId     String?
  triggerDate  DateTime
  channel      String
  sentAt       DateTime     @default(now())
  success      Boolean      @default(true)
  metadata     Json?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder_logs")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  action      String
  targetTable String
  targetId    String
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime @default(now())
  metadata    Json?
  recorded    DateTime @default(now())
  meta        Json?
  actor       User     @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@map("audit_logs")
}

model ChatEmbedding {
  id         String                 @id @default(uuid())
  content    String
  language   Language
  sourceType String
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())

  @@map("chat_embeddings")
}

model ChatLog {
  id               String   @id @default(uuid())
  userId           String?
  question         String
  detectedLanguage Language
  answer           String
  wasEscalated     Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@map("chat_logs")
}

model ChatMessage {
  id        String          @id @default(uuid())
  userId    String
  role      ChatMessageRole
  content   String
  language  Language
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("chat_messages")
}

model AdminSettings {
  key         String @id
  totalBudget Int    @default(0)

  @@map("admin_settings")
}

model Semester {
  id        String  @id @default(uuid())
  name      String
  isCurrent Boolean @default(false)

  @@map("semesters")
}

model AccountingPayout {
  id        String    @id @default(uuid())
  granteeId String    @unique
  amount    Int
  semester  String?
  claimedAt DateTime? @map("claimed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("accounting_payouts")
}

model registrations {
  id            String   @id
  eventId       String
  userId        String
  registeredAt  DateTime @default(now())
  address       String?
  age           Int?
  contactNumber String?
  email         String?
  fullName      String?
  sex           String?
  users         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

enum ReminderType {
  SKEAP_APPLICATION
  EVENT_REGISTRATION
}

enum Role {
  YOUTH
  GRANTEE
  SK_OFFICIAL
  SUPER_ADMIN
}

enum GranteeStatus {
  ACTIVE
  PROBATIONARY
  GRADUATED
  REMOVED
}

enum EventStatus {
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED_FOR_EDIT
  WAITLISTED
}

enum Language {
  ENGLISH
  FILIPINO
  ILOCANO
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum EventAllowedType {
  SOLO_ONLY
  GROUP_ONLY
  BOTH
}
